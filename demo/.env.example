# Demo password (leave blank to disable auth in local dev)
DEMO_PASSWORD=

# Guardian Open Platform API
GUARDIAN_API_KEY=

# Telegraph RSS Feed API
TELEGRAPH_API_KEY=
TELEGRAPH_API_URL=

# Mistral AI
MISTRAL_API_KEY=

# OpenAttribution server endpoints (writes vs reads — both may point at
# the same deployment, e.g. http://localhost:8080 for a local server).
# The demo has no default host; it talks only to what you configure here.
OA_TELEMETRY_URL=
OA_API_URL=

# OA API keys, minted per organisation through the OA identity API.
# OA_PLATFORM_KEY is the chat agent org's write key (oat_pk_ prefix).
# The per-publisher keys are content-owner read keys (oat_pub_ prefix);
# each key only sees telemetry for that publisher's verified domains.
# Against a local OA server, mint all three with the server operator's
# provision-local-demo.sh script and paste its output here.
OA_PLATFORM_KEY=
OA_PUBLISHER_KEY_GUARDIAN=
OA_PUBLISHER_KEY_TELEGRAPH=
